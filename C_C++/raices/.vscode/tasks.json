{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar raices con GSL",
      "type": "shell",
      "command": "g++",
      "args": [
        "main.cpp",
        "-o",
        "raices",
        "-lgsl",
        "-lgslcblas",
        "-lm"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "showReuseMessage": false,
        "close": true
      }
    }
  ]
}
